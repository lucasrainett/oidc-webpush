# ─── server ─────────────────────────────────────────────────────────────────
BASE_URL=https://notify.mgtd.net      # public URL behind Traefik
PORT=3000
HOST=0.0.0.0

# ─── SMTP ingress ───────────────────────────────────────────────────────────
SMTP_PORT=2525
SMTP_HOST=0.0.0.0
# Optional. If unset, SMTP accepts unauthenticated mail (fine if bound to a
# trusted network only). Recommended when reachable from anywhere.
# SMTP_AUTH_USER=mailrise
# SMTP_AUTH_PASS=replace-me

# ─── Authentik OIDC ─────────────────────────────────────────────────────────
# Issuer URL for your Authentik OAuth2/OpenID provider's *application*.
# Authentik shows this as "OpenID Configuration Issuer" on the provider page.
OIDC_ISSUER=https://authentik.mgtd.net/application/o/notify/
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me

# ─── Web Push (VAPID) ───────────────────────────────────────────────────────
# Generate once with `npm run gen-vapid`. Rotating these invalidates every
# existing push subscription, so treat them as permanent.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:[email protected]

# ─── Session ────────────────────────────────────────────────────────────────
# 32+ bytes of random. Generate with: openssl rand -hex 32
COOKIE_SECRET=

# ─── Storage ────────────────────────────────────────────────────────────────
DB_PATH=./data/notify.db

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
