# ─── server ─────────────────────────────────────────────────────────────────
BASE_URL=https://notify.example.com      # public HTTPS URL
PORT=3000
HOST=0.0.0.0

# ─── SMTP ingress ───────────────────────────────────────────────────────────
SMTP_PORT=2525
SMTP_HOST=0.0.0.0

# ─── OIDC SSO ─────────────────────────────────────────────────────────────────
OIDC_ISSUER=https://sso.example.com
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me

# ─── Web Push (VAPID) ───────────────────────────────────────────────────────
# Generate once with `pnpm run gen-vapid`. Rotating these invalidates every
# existing push subscription, so treat them as permanent.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@localhost

# ─── Session ────────────────────────────────────────────────────────────────
# 32+ bytes of random. Generate with: openssl rand -hex 32
COOKIE_SECRET=

# ─── Storage ────────────────────────────────────────────────────────────────
DB_PATH=./data/oidc-webpush.db

# ─── Admin ──────────────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@example.com

# ─── AI / Ollama ────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=5000
OLLAMA_MAX_CONCURRENCY=2
OLLAMA_QUEUE_TIMEOUT_MS=120000
AI_BYPASS_PATTERNS=2fa|verification|otp|alert
AI_SKIP_PATTERNS=password|reset|credit card
AI_FILTER_DEFAULT=true

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Optional ────────────────────────────────────────────────────────────────
# Human-readable SMTP address shown in the dashboard (e.g. notify.example.com:2525)
# Defaults to the server hostname + SMTP_PORT if not set.
SMTP_ENDPOINT=

# Number of days to retain events. 0 = keep forever.
EVENT_RETENTION_DAYS=0
