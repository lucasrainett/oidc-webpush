{
  "name": "oidc-webpush",
  "version": "0.1.0",
  "description": "Self-hosted email-to-push notification gateway with OIDC SSO",
  "private": true,
  "type": "module",
  "main": "dist/app.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "gen-vapid": "node -e \"const w=require('web-push');const k=w.generateVAPIDKeys();console.log('VAPID_PUBLIC='+k.publicKey);console.log('VAPID_PRIVATE='+k.privateKey)\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^8.1.1",
    "@node-rs/argon2": "^2.0.0",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.1",
    "mailparser": "^3.7.2",
    "nanoid": "^5.0.9",
    "openid-client": "^5.7.1",
    "smtp-server": "^3.13.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.5",
    "@types/smtp-server": "^3.5.10",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
